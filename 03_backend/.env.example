# Copie este archivo como .env para correr el backend en su computador.
# NUNCA suba el .env a GitHub (ya está en .gitignore).

# Supabase → botón «Connect» → «Transaction pooler» (puerto 6543, funciona por IPv4)
DATABASE_URL=postgresql://postgres.SU_PROYECTO:SU_CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres

# Dominio de la app en Netlify (separe varios con coma)
CORS_ORIGINS=https://hidrosopo.netlify.app,http://localhost:5500

# simulacion = la base tiene datos del gemelo digital · campo = datos del nodo real
FUENTE_DATOS=simulacion

CANAL_ALERTAS=consola
LLM_PROVEEDOR=ninguno
TZ=America/Bogota
